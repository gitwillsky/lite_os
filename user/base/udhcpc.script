#!/bin/sh

# @description BusyBox udhcpc 唯一 lease consumer；只通过标准 ioctl/route 与 resolv.conf 提交配置。
case "$1" in
    deconfig)
        route del default dev "$interface" 2>/dev/null || true
        ifconfig "$interface" 0.0.0.0
        rm -f /etc/resolv.conf
        ;;
    bound|renew)
        ifconfig "$interface" "$ip" ${subnet:+netmask "$subnet"} \
            ${broadcast:+broadcast "$broadcast"} up

        route del default dev "$interface" 2>/dev/null || true
        for gateway in $router; do
            route add default gw "$gateway" dev "$interface"
            break
        done

        resolv_conf="/run/resolv.conf.$$"
        : > "$resolv_conf"
        if [ -n "$domain" ]; then
            printf 'search %s\n' "$domain" >> "$resolv_conf"
        fi
        # /etc/network/interfaces 为该接口指定了 dns-nameservers（“使用下面的 DNS 服务器地址”）时覆盖租约 DNS。
        configured=$(awk -v name="$interface" '
            $1 == "iface" { current = $2 }
            current == name && $1 == "dns-nameservers" { for (i = 2; i <= NF; i++) print $i }
        ' /etc/network/interfaces 2>/dev/null)
        for server in ${configured:-$dns}; do
            printf 'nameserver %s\n' "$server" >> "$resolv_conf"
        done
        mv "$resolv_conf" /etc/resolv.conf
        ;;
esac

exit 0

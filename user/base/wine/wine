#!/bin/sh
# 当前登录用户独占一份 Windows 环境；安装器、生成的 .desktop 与手工启动均经过此入口。
# 1. 禁止 UART 的初始 HOME=/ 把用户环境误装到根目录；登录会话已设置真实 HOME。
case "${HOME:-}" in
    /*) [ "$HOME" != / ] || { echo 'wine: 请先设置当前账户的 HOME' >&2; exit 1; } ;;
    *) echo 'wine: HOME 必须是当前账户的绝对主目录' >&2; exit 1 ;;
esac
# 2. Wine menubuilder 直接输出标准 Desktop Entry/PNG；不维护另一份应用或快捷方式数据库。
export WINEPREFIX="$HOME/.wine"
export XDG_CURRENT_DESKTOP=LiteOS
export HODLL=libwow64fex.dll
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=}"
export WAYLAND_DISPLAY=/run/liteos/wayland-0
mkdir -p "$HOME/Desktop" || exit 1
# 3. 替换本进程，保留调用者参数、退出码和信号；不把 Windows 命令交给 shell 二次解释。
exec /opt/wine/bin/wine "$@"
